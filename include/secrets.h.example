#pragma once

// static const so this header can be safely included from multiple .cpp files
// without duplicate-symbol link errors.
static const char* const ssid = "your-wifi-ssid";
static const char* const password = "your-wifi-password";

// ntfy.sh topic for air quality push notifications.
// 1. Pick a hard-to-guess topic name (it's public - anyone who knows it can read/post).
// 2. Install the ntfy app (Android/iOS) or open https://ntfy.sh/<topic> and subscribe.
// 3. Put that same topic name here.
static const char* const ntfyTopic = "esp32-airquality-CHANGE-ME";

// OTA (over-the-air) upload password. Must match --auth in platformio_local.ini.
// Without this, ArduinoOTA accepts unauthenticated firmware pushes from anyone on the LAN.
static const char* const otaPassword = "CHANGE-ME-OTA-PASSWORD";
